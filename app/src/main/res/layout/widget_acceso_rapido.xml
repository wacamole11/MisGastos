<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- 1. ENCABEZADO: Avatar Copiloto + Título + Saldo Disponible -->
    <LinearLayout
        android:id="@+id/widget_btn_open_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@mipmap/ic_launcher_round" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Copiloto MisGastos"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● IA Lista para registrar"
                android:textColor="#22C55E"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_txt_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_chip"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="Disp: S/ --"
            android:textColor="#76D1FF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. BURBUJA DE CHAT DEL ASISTENTE ("EL CHATSITO") -->
    <LinearLayout
        android:id="@+id/widget_chat_bubble"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_widget_chat_bubble"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_chat_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:text="¡Hola! 👋 ¿Qué compraste hoy? Tócame para dictar por voz o escribir tu gasto."
            android:textColor="#E2E8F0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_chat_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Toca para responder o registrar gasto"
            android:textColor="#76D1FF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. CHIPS RÁPIDOS DE CATEGORÍAS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_chip_1"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🍱 Almuerzo"
            android:textColor="#BAC7D5"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_chip_2"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🚗 Pasaje"
            android:textColor="#BAC7D5"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_chip_3"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🛒 Super"
            android:textColor="#BAC7D5"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_chip_4"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="☕ Café"
            android:textColor="#BAC7D5"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 4. BARRA DE ENTRADA ESTILO CHAT (PILL) -->
    <LinearLayout
        android:id="@+id/widget_chat_bar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_widget_chat_input"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_widget_chat" />

        <TextView
            android:id="@+id/widget_txt_placeholder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Dicta o escribe un gasto..."
            android:textColor="#718096"
            android:textSize="11sp" />

        <!-- Botón Voz (Micrófono) -->
        <FrameLayout
            android:id="@+id/widget_btn_voice"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_widget_circle_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_mic_dark" />
        </FrameLayout>

        <!-- Botón Escribir / Enviar -->
        <FrameLayout
            android:id="@+id/widget_btn_write"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_widget_circle_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_send" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
